---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '@layout/BaseHead.astro';
import Footer from '@layout/Footer.astro';
import FormattedDate from '@utils/FormattedDate.astro';
import Header from '@layout/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang='en'>
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class='w-[calc(100%-2em)] max-w-full flex align-mid justify-center my-5'>
			<article>
				<div
					class='hero-section mx-3 w-full bg-[#0f1115] rounded-xl border border-slate-800 overflow-hidden flex flex-col p-6 sm:p-10 gap-8'
				>
					{
						heroImage && (
							<div class='w-full flex items-center justify-center py-4'>
								<Image
									width={1020}
									height={510}
									src={heroImage}
									alt=''
									class='max-w-full h-auto max-h-[400px] rounded-2xl border border-slate-800 object-cover'
								/>
							</div>
						)
					}
					<div class='flex flex-col text-left'>
						<h1
							class='title m-0 mb-4 text-4xl sm:text-5xl font-bold text-white tracking-wide'
						>
							{title}
						</h1>
						{
							description && (
								<p class='text-slate-400 text-lg mb-6'>
									{description}
								</p>
							)
						}
						<div
							class='date meta flex flex-col items-start gap-1 text-slate-500 text-sm'
						>
							{
								updatedDate && (
									<div class='last-updated-on'>
										最後編輯：
										<FormattedDate
											date={
												updatedDate
											}
										/>
									</div>
								)
							}
							<div>
								最初建立於：<FormattedDate
									date={pubDate}
								/>
							</div>
						</div>
					</div>
				</div>
				<div class='content container py-10'>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
