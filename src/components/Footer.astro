---
const today = new Date();
---

<footer class="layout-container py-8 pb-24 text-center bg-gradient-to-b from-gray-50 to-white text-gray-600">
	&copy; {today.getFullYear()} Your name here. All rights reserved.
	<div class='social-links flex justify-center gap-4 mt-4'>
		<a href='https://m.webtoo.ls/@astro' target='_blank' class="text-gray-600 hover:text-gray-800 no-underline">
			<span class='sr-only'>Follow Astro on Mastodon</span>
			<div class="i-lucide-mastodon text-2xl"></div>
		</a>
		<a href='https://twitter.com/astrodotbuild' target='_blank' class="text-gray-600 hover:text-gray-800 no-underline">
			<span class='sr-only'>Follow Astro on Twitter</span>
			<div class="i-lucide-twitter text-2xl"></div>
		</a>
		<a href='https://github.com/withastro/astro' target='_blank' class="text-gray-600 hover:text-gray-800 no-underline">
			<span class='sr-only'>Go to Astro's GitHub repo</span>
			<div class="i-lucide-github text-2xl"></div>
		</a>
	</div>
</footer>
