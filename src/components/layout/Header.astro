---
import HeaderLink from '@ui/HeaderLink.astro';
import ThemeToggle from '@utils/ThemeToggle.svelte';
import { SITE_TITLE } from '@consts';
---

<header class='nerd-mono py-4'>
	<nav class='flex items-center justify-between mx-10'>
		<h2 class='m-0 text-base'>
			<a href='/' class='text-inherit no-underline hover:text-inherit'
				>{SITE_TITLE}</a
			>
		</h2>
		<div class='internal-links'>
			<HeaderLink href='/blog'>Blog</HeaderLink>
			<ThemeToggle client:load />
		</div>
		<!-- Social links placeholder -->
	</nav>
</header>
<style scoped>
	header {
		background-color: var(--neutral-base);
	}
	nav {
		color: var(--neutral-900);
	}
</style>
