---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '@layout/BaseHead.astro';
import Footer from '@layout/Footer.astro';
import FormattedDate from '@utils/FormattedDate.astro';
import Header from '@layout/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@consts';

const blogCollection = await getCollection('blog');
const posts = blogCollection.toSorted(
	(firstPost, secondPost) =>
		secondPost.data.pubDate.valueOf() - firstPost.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class='w-90% mx-auto'>
			<section>
				<ul class='flex flex-wrap gap-8 list-none m-0 p-0 max-sm:gap-2'>
					{
						posts.map((post, index) => (
							<li
								class={`w-[calc(50%-1rem)] max-sm:w-full max-sm:text-center ${index === 0 ? 'first:w-full first:mb-4 first:text-center max-sm:first:mb-0' : ''}`}
							>
								<a
									href={`/blog/${post.id}/`}
									class='block no-underline transition duration-200 ease-in-out group hover:bg-[var(--color-surface-hover)] rounded-xl p-2'
								>
									{post.data.heroImage && (
										<Image
											width={720}
											height={360}
											src={
												post
													.data
													.heroImage
											}
											alt=''
											class={`mb-2 rounded-3xl ${index === 0 ? 'first:w-full' : ''} transition duration-200 ease-in-out`}
										/>
									)}
									<h4 class={`m-0 leading-none title ${index === 0 ? 'first:text-4xl max-sm:first:text-2xl' : ''}`}>
										{post.data.title}
									</h4>
									<p class='m-0 date mt-2'>
										<FormattedDate
											date={
												post
													.data
													.pubDate
											}
										/>
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		background-color: var(--color-background);
		color: var(--color-text-primary);
	}
	
	.title {
		color: var(--color-text-primary);
	}
	
	.date {
		color: var(--color-text-tertiary);
	}
	
	a:hover .title {
		color: var(--color-primary);
	}
	
	a:hover .date {
		color: var(--color-primary-hover);
	}
	
	/* Adding specific shadow based on theme variables for image */
	a:hover img {
		box-shadow: 0 10px 15px -3px var(--shadow-color-strong);
	}
</style>
