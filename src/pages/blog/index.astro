---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '@layout/BaseHead.astro';
import Footer from '@layout/Footer.astro';
import FormattedDate from '@utils/FormattedDate.astro';
import Header from '@layout/Header.astro';
import PagefindSearch from '@utils/PagefindSearch.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@consts';

const blogCollection = await getCollection('blog');
const posts = blogCollection.toSorted(
	(firstPost, secondPost) =>
		secondPost.data.pubDate.valueOf() - firstPost.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class='w-90% mx-auto'>
			<section class='text-center align-mid flex-1 justify-center mt-16 mb-12'>
				<h1 class='text-5xl max-sm:text-3xl font-bold mb-4'>Blogs</h1>
				<p
					class='text-lg max-sm:text-base text-[var(--color-text-secondary)] mb-8'
				>
					Read my latest thoughts and updates on web development,
					programming, and technology.
				</p>
				<div class='max-w-md mx-auto mb-10'>
					<PagefindSearch />
				</div>
			</section>
			<section>
				<ul class='flex flex-col gap-6 list-none m-0 p-0'>
					{
						posts.map(post => (
							<li class='w-full'>
								<a
									href={`${import.meta.env.BASE_URL}${post.id}/`}
									class='flex flex-col sm:flex-row gap-6 no-underline transition duration-200 ease-in-out group hover:bg-[var(--color-surface-hover)] rounded-xl p-4'
								>
									{post.data.heroImage && (
										<div class='sm:w-1/3 shrink-0'>
											<Image
												width={
													720
												}
												height={
													360
												}
												src={
													post
														.data
														.heroImage
												}
												alt=''
												class='w-full h-full object-cover rounded-xl transition duration-200 ease-in-out shadow-sm group-hover:shadow-md'
											/>
										</div>
									)}
									<div class='flex flex-col justify-center sm:w-2/3'>
										<h4 class='m-0 text-2xl font-bold title'>
											{
												post
													.data
													.title
											}
										</h4>
										{post.data
											.description && (
											<p class='m-0 mt-3 text-[var(--color-text-secondary)] line-clamp-3'>
												{
													post
														.data
														.description
												}
											</p>
										)}
										<p class='m-0 date mt-auto pt-4 text-sm'>
											<FormattedDate
												date={
													post
														.data
														.pubDate
												}
											/>
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		background-color: var(--color-background);
		color: var(--color-text-primary);
	}

	.title {
		color: var(--color-text-primary);
	}

	.date {
		color: var(--color-text-tertiary);
	}

	a:hover .title {
		color: var(--color-primary);
	}

	a:hover .date {
		color: var(--color-primary-hover);
	}

	/* Adding specific shadow based on theme variables for image */
	a:hover img {
		box-shadow: 0 10px 15px -3px var(--shadow-color-strong);
	}
</style>
