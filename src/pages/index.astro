---
import { SITE_DESCRIPTION, SITE_TITLE } from '@consts';
import BaseHead from '@layout/BaseHead.astro';
import Footer from '@layout/Footer.astro';
import Header from '@layout/Header.astro';
import BlogCards from '@components/ui/BlogCards.astro';
import SkillCards from '@components/ui/SkillCards.svelte';
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main
			class='nerd-mono flex-1 flex flex-col items-center justify-center gap-24 py-16'
		>
			<div class='pt-16'>
				<h1 class='text-5xl font-bold mb-4'>
					Welcome to tonicatOWO's Blog
				</h1>
				<p class='text-lg text-gray-600 mb-8'>
					A place where I share my thoughts and projects.
				</p>
			</div>
			<BlogCards />
			<section class='pt-[18vh] pb-[10vh]'>
				<h1 class='text-3xl m-10'>Skill Tree</h1>

				<SkillCards />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		background-color: var(--color-background);
		color: var(--color-text-primary);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
</style>
