---
import { SITE_DESCRIPTION, SITE_TITLE } from '@consts';
import BaseHead from '@layout/BaseHead.astro';
import Footer from '@layout/Footer.astro';
import Header from '@layout/Header.astro';
import BlogCards from '@components/ui/BlogCards.astro';
import SkillCards from '@components/ui/SkillCards.svelte';
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main
			class='nerd-mono flex-1 flex flex-col items-center justify-center gap-20 py-16'
		>
			<section>
				<div class='pb-10'>
					<h1 class='text-5xl font-bold mb-4'>
						Welcome to tonicatOWO's Blog
					</h1>
					<p class='text-lg mb-8'>
						A place where I share my thoughts and projects.
					</p>
				</div>
				<div>
					<h1 class='text-5xl font-bold mb-4'>Whoami</h1>
					<p class='text-2xl mb-8'>
						我是一位來自臺灣的高中生，自學開發約 5y 多
					</p>
					<h2 class='text-3xl font-bold'>同時我也是</h2>
					<ul class='list-disc list-inside list-roman text-lg mt-4'>
						<li class='text-2xl py-3'>業餘 Website designer</li>
						<li class='text-2xl py-3'>Fullstack developer</li>
					</ul>
				</div>
			</section>
			<BlogCards />
			<section class='pt-10 pb-16'>
				<h1 class='text-3xl m-10'>Skill Tree</h1>

				<SkillCards />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		background-color: var(--color-background);
		color: var(--color-text-primary);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
</style>
