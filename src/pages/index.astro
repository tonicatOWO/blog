---
import { SITE_DESCRIPTION, SITE_TITLE } from '@consts';
import BaseHead from '@layout/BaseHead.astro';
import Footer from '@layout/Footer.astro';
import Header from '@layout/Header.astro';
import BlogCards from '@components/ui/BlogCards.astro';
import SkillCards from '@components/ui/SkillCards.svelte';
---

<!doctype html>
<html lang='zh-Hant'>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main
			class='nerd-mono flex-1 flex flex-col items-center justify-center gap-10 md:gap-20 py-10 md:py-16 px-4 sm:px-6 lg:px-8'
		>
			<section class='w-full max-w-4xl'>
				<div class='pb-6 md:pb-10'>
					<h1
						class='text-3xl sm:text-4xl md:text-5xl font-bold mb-3 md:mb-4'
					>
						Welcome to tonicatOWO's Blog
					</h1>
					<p class='text-base md:text-lg mb-6 md:mb-8'>
						A place where I share my thoughts and projects.
					</p>
				</div>
				<div>
					<h2
						class='text-3xl sm:text-4xl md:text-5xl font-bold mb-3 md:mb-4'
					>
						Whoami
					</h2>
					<p class='text-lg md:text-2xl mb-6 md:mb-8 leading-relaxed'>
						我是一位來自臺灣的高中生，自學開發約 5y 多
					</p>
					<h3 class='text-xl md:text-3xl font-bold mb-2 md:mb-0'>
						同時我也是
					</h3>
					<ul class='[list-style-type:lower-roman] list-inside mt-3 md:mt-4 space-y-2'>
						<li
							class='text-base md:text-xl lg:text-2xl py-1 md:py-2 lg:py-3'
						>
							業餘 Website designer
						</li>
						<li
							class='text-base md:text-xl lg:text-2xl py-1 md:py-2 lg:py-3'
						>
							Fullstack developer
						</li>
					</ul>
				</div>
			</section>
			<BlogCards />
			<section class='pt-6 md:pt-10 pb-10 md:pb-16 w-full max-w-4xl'>
				<h2 class='text-2xl md:text-3xl mb-6 md:mb-10 text-center'>
					Skill Tree
				</h2>

				<SkillCards />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		background-color: var(--color-background);
		color: var(--color-text-primary);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	/* Mobile-specific improvements for the index page */
	@media (max-width: 640px) {
		/* Improve readability of long Chinese text */
		.nerd-mono {
			line-height: 1.6;
		}

		/* Ensure content doesn't overflow horizontally */
		section {
			overflow-wrap: break-word;
			word-wrap: break-word;
		}
	}
</style>
