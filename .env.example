# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Anubis Configuration
ANUBIS_TARGET=http://host.docker.internal:4321
ANUBIS_BIND=0.0.0.0:3923
ANUBIS_DIFFICULTY=2
ANUBIS_SERVE_ROBOTS_TXT=true

# Nginx Configuration (for reference)
NGINX_PORT=4321
NGINX_ROOT=/home/tomycat/code/blogs/dist

# Redis Configuration
REDIS_IMAGE=redis:alpine

# Cloudflared Configuration
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Anubis Image
ANUBIS_IMAGE=ghcr.io/techarohq/anubis:latest