{
        "name": "blogs",
        "version": "0.0.1",
        "type": "module",
        "scripts": {
                "dev": "astro dev",
                "build": "astro build && node script/font-subset.mjs",
                "preview": "astro preview",
                "astro": "astro",
                "lint": "bun run lint:ox && bun run lint:es",
                "lint:ox": "oxlint --config .oxlintrc.json",
                "lint:es": "eslint .",
                "lint:fix": "bun run lint:ox:fix && bun run lint:es:fix",
                "lint:ox:fix": "oxlint --config .oxlintrc.json --fix",
                "lint:es:fix": "eslint . --fix",
                "format": "prettier --write .",
                "format:check": "prettier --check .",
                "type-check": "tsc --noEmit",
                "check": "bun run type-check && bun run lint && bun run format:check",
                "deploy": "wrangler deploy"
        },
        "dependencies": {
                "@astrojs/check": "0.9.9",
                "@astrojs/mdx": "6.0.3",
                "@astrojs/rss": "^4.0.18",
                "@astrojs/sitemap": "3.7.3",
                "@astrojs/svelte": "8.1.2",
                "astro": "6.4.6",
                "sharp": "^0.34.3",
                "subset-font": "^2.5.0",
                "svelte": "^5.55.1",
                "typescript": "^6.0.2"
        },
        "devDependencies": {
                "@eslint/js": "^10.0.1",
                "@iconify-json/catppuccin": "^1.2.17",
                "@iconify-json/lucide": "^1.2.101",
                "@typescript-eslint/eslint-plugin": "^8.58.0",
                "@typescript-eslint/parser": "^8.58.0",
                "@unocss/astro": "^66.6.7",
                "@unocss/preset-attributify": "^66.6.7",
                "@unocss/preset-icons": "^66.6.7",
                "@unocss/preset-typography": "^66.6.7",
                "@unocss/preset-wind": "^66.6.7",
                "@unocss/preset-wind4": "^66.6.7",
                "astro-pagefind": "^1.8.6",
                "eslint": "^10.1.0",
                "eslint-plugin-astro": "^1.6.0",
                "eslint-plugin-svelte": "^3.16.0",
                "oxlint": "^1.57.0",
                "prettier": "^3.8.1",
                "prettier-plugin-astro": "^0.14.1",
                "prettier-plugin-svelte": "^3.5.1",
                "unocss": "^66.6.7",
                "wrangler": "^4.82.2"
        },
        "engines": {
                "node": ">=22.12.0"
        }
}
